# ============================================================
# Docker Ignore File for Next.js Todo Frontend
# Purpose: Exclude unnecessary files from Docker build context
# ============================================================

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js build output
.next/
out/

# Testing
coverage/
.nyc_output/
__tests__/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx

# Environment files (secrets should never be in images)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
*.log

# Git
.git/
.gitignore
.gitattributes

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Documentation
README.md
CHANGELOG.md
*.md
docs/

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
Jenkinsfile

# Docker
Dockerfile*
.dockerignore
docker-compose*.yml

# Misc
.editorconfig
.eslintrc*
.prettierrc*
.stylelintrc*
tsconfig.tsbuildinfo
