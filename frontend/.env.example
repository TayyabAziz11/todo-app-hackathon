# =================================================================
# Frontend Environment Variables
# =================================================================
# Set these in Vercel: Project Settings > Environment Variables
# DO NOT use .env files in production - use Vercel's UI
# =================================================================

# =================================================================
# Phase 2: Auth & Todos Backend API (REQUIRED)
# =================================================================
# Development: http://localhost:8000
# Production (Hugging Face): https://tayyabaziz-todo-app-phase2.hf.space
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# =================================================================
# Phase 3: AI Chatbot API (REQUIRED for chat feature)
# =================================================================
# Development: http://localhost:8000 (if running Phase 3 locally)
# Production (Hugging Face): https://<your-chat-backend>.hf.space
# Note: Phase 3 chatbot is deployed separately from Phase 2
NEXT_PUBLIC_CHAT_API_URL=http://localhost:8000

# =================================================================
# VERCEL DEPLOYMENT INSTRUCTIONS
# =================================================================
# 1. Go to Vercel Dashboard > Your Project > Settings
# 2. Click "Environment Variables"
# 3. Add Phase 2 backend:
#    NEXT_PUBLIC_API_BASE_URL = https://tayyabaziz-todo-app-phase2.hf.space
# 4. Add Phase 3 chatbot (if deployed separately):
#    NEXT_PUBLIC_CHAT_API_URL = https://<your-chat-backend>.hf.space
# 5. Redeploy the application
# =================================================================
